BOT_TOKEN=123456789:AAExampleTokenFromBotFather
ADMIN_ID=123456789
PROMO_CODE=SEPTEMBER12
PRICE_STARS=2500
SUBSCRIPTION_PERIOD_RU=12 месяцев
SUBSCRIPTION_PERIOD_EN=12 months
PRODUCT_NAME_RU=журнал «Хакер»
PRODUCT_NAME_EN=«Hacker» magazine

# Оплата картой/криптой через Cryptomus (https://cryptomus.com).
# Если не заполнить — кнопка "Карта / Крипта" просто не покажется, Stars продолжат работать.
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
PRICE_USD=5
# Публичный URL этого сервиса на Railway (Settings -> Networking -> Generate Domain),
# нужен, чтобы Cryptomus знал, куда слать вебхук об оплате.
PUBLIC_URL=https://your-app.up.railway.app

# Необязательно: полностью переопределяют формулировки.
# Плейсхолдеры: {product} {period} {price} {code} (см. README).
# OFFER_TEXT_RU=Промокод на подписку на {product} ({period}) ⭐️\n\nЦена: {price} Stars
# OFFER_TEXT_EN=Subscription promo code for {product} ({period}) ⭐️\n\nPrice: {price} Stars
# INVOICE_TITLE_RU=Промокод: {product} ({period})
# INVOICE_TITLE_EN=Promo code: {product} ({period})
# INVOICE_DESCRIPTION_RU=Промокод для активации подписки на {product} ({period})
# INVOICE_DESCRIPTION_EN=Activation promo code for a {product} subscription ({period})
# PAY_LABEL_RU=Промокод: {product} ({period})
# PAY_LABEL_EN=Promo code: {product} ({period})
# THANKS_TEXT_RU=Спасибо за покупку! ⭐️\n\nВаш промокод на подписку на {product} ({period}):\n\n{code}\n\nАктивируйте его в личном кабинете на сайте.
# THANKS_TEXT_EN=Thanks for your purchase! ⭐️\n\nYour {product} subscription promo code ({period}):\n\n{code}\n\nActivate it in your account on the website.
# BUY_BUTTON_RU=GET LINK!
# BUY_BUTTON_EN=GET LINK!
# SOLD_OUT_TEXT_RU=Промокоды закончились. Попробуйте позже или напишите в поддержку.
# SOLD_OUT_TEXT_EN=Promo codes are sold out. Please try again later or contact support.
